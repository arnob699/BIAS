# Google Gemini API Configuration (Primary Engine - https://aistudio.google.com/apikey)
# Supports single key or multiple fallback keys (comma-separated):
# GEMINI_API_KEY=key_1,key_2,key_3
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq API Configuration (Automatic Fallback when Gemini hits 429 quota - https://console.groq.com/keys)
# Supports single key or multiple fallback keys (comma-separated):
# GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
